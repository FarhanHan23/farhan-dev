---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("post", ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

function formatDate(date: Date) {
  const months = [
    "Januari", "Februari", "Maret", "April", "Mei", "Juni",
    "Juli", "Agustus", "September", "Oktober", "November", "Desember"
  ];
  return `${months[date.getMonth()]} ${date.getFullYear()}`;
}
---

<BaseLayout title="Blog & Idea | FarhanAkmal.dev" description="Kumpulan artikel, catatan teknikal, dan ide dari Farhan Akmal.">
  <div class="pt-8 pb-12">
    <div class="flex items-center justify-between mb-8 pb-4 border-b border-[#313844]">
      <div>
        <h1 class="text-2xl md:text-3xl font-bold text-[#c6f135]">Idea & Articles</h1>
        <p class="text-sm text-[#8e98a5] mt-1 font-mono">Kumpulan pemikiran, catatan teknikal, dan eksplorasi engineering.</p>
      </div>
      <a href="/" class="text-sm text-[#8e98a5] hover:text-[#c6f135] transition-colors font-mono">
        ← Kembali
      </a>
    </div>

    <div class="flex flex-col">
      {sortedPosts.map((post) => (
        <div>
          <a
            href={`/blog/${post.id}`}
            class="group py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-sm md:text-base text-[#d1d5db] hover:text-white transition-colors"
          >
            <div>
              <span class="font-medium group-hover:text-white transition-colors block">
                {post.data.title}
              </span>
              <p class="text-xs text-[#8e98a5] mt-1 line-clamp-1">{post.data.description}</p>
            </div>
            <span class="self-start sm:self-center border border-[#c6f135] text-[#c6f135] text-xs font-mono px-3 py-1 tracking-tight shrink-0">
              {formatDate(post.data.publishedAt)}
            </span>
          </a>
          <div class="dashed-divider my-1"></div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
