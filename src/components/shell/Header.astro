---
import { siteConfig } from "../../config/site";
---

<header class="w-full pt-12 pb-8">
  <div class="flex flex-col gap-5">
    <!-- Desktop Avatar / Profile Picture -->
    <div class="flex items-center gap-4">
      <img
        src="/avatar.png"
        alt="Farhan Akmal"
        class="w-20 h-20 rounded-none shadow-md object-cover border border-[#313844]"
      />
      <div>
        <h1 class="text-2xl md:text-3xl font-bold text-white tracking-tight">
          <a href="/" class="hover:text-[#c6f135] transition-colors">
            {siteConfig.title}
          </a>
        </h1>
        <p class="text-xs md:text-sm text-[#8e98a5] font-mono mt-1">
          {siteConfig.subtitle}
        </p>
      </div>
    </div>

    <!-- Bio Description matching Figma -->
    <p class="text-sm md:text-base text-[#d1d5db] leading-relaxed max-w-2xl mt-2 font-normal">
      {siteConfig.bio}
    </p>
  </div>
</header>
